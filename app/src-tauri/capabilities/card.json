{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "card",
  "description": "A pet's info card: that pet's actions, goal and settings",
  "windows": [
    "card"
  ],
  "permissions": [
    "core:event:default",
    "allow-ui-state",
    "allow-close-window",
    "allow-open-github",
    "allow-open-window",
    "allow-pet-action",
    "allow-reveal",
    "allow-set-goal",
    "allow-set-pet"
  ]
}
