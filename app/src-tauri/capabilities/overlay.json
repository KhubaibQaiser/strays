{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "overlay",
  "description": "The pet overlays (one per display) show web content all the time, so they may only report clicks and drags and ask for frames",
  "windows": [
    "overlay",
    "overlay-*"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-pet-click",
    "allow-pet-press",
    "allow-pet-drop",
    "allow-overlay-ready",
    "allow-pet-log",
    "allow-report-problem",
    "allow-pet-menu"
  ]
}
