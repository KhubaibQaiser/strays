<Rive version="1" kind="fragment">
    <!-- Gate 0 test cat (Persian, sitting, facing the viewer). Draw order: first declared paints on top. -->
    <Artboard defaultStateMachineId="0:7" styleId="0:5" viewModelId="0:500" viewModelInstanceId="0:510" width="400" height="400" name="Cat" id="0:2">
        <LayoutComponentStyle name="Artboard Style" id="0:5"/>

        <!-- Cat root: origin sits on the ground line, centred -->
        <Node x="200" y="370" name="Cat" id="0:20">

            <!-- Head group: pivot at head centre; bobs with breathing -->
            <Node x="0" y="-178" name="Head" id="0:22">

                <!-- Face features (on top of the head) -->
                <Node x="0" y="2" name="Eyes" id="0:23">
                    <Shape x="-21" y="-6" name="Glint L">
                        <Ellipse width="7" height="7" originX="0.5" originY="0.5" name="Path"/>
                        <Fill name="Fill"><SolidColor colorValue="FFFFFFFF" name="C"/></Fill>
                    </Shape>
                    <Shape x="33" y="-6" name="Glint R">
                        <Ellipse width="7" height="7" originX="0.5" originY="0.5" name="Path"/>
                        <Fill name="Fill"><SolidColor colorValue="FFFFFFFF" name="C"/></Fill>
                    </Shape>
                    <Shape x="-27" y="1" name="Pupil L">
                        <Ellipse width="15" height="22" originX="0.5" originY="0.5" name="Path"/>
                        <Fill name="Fill"><SolidColor colorValue="FF2A1E18" name="C"/></Fill>
                    </Shape>
                    <Shape x="27" y="1" name="Pupil R">
                        <Ellipse width="15" height="22" originX="0.5" originY="0.5" name="Path"/>
                        <Fill name="Fill"><SolidColor colorValue="FF2A1E18" name="C"/></Fill>
                    </Shape>
                    <Shape x="-27" y="0" name="Iris L">
                        <Ellipse width="30" height="31" originX="0.5" originY="0.5" name="Path"/>
                        <Fill name="Fill"><SolidColor colorValue="FFD9902E" name="C"/></Fill>
                        <Stroke thickness="2.5" name="Rim">
                            <SolidColor colorValue="FF5A3A22" name="C">
                                <DataBindContext sourcePathIds="0:500-0:504" propertyKey="37"/>
                            </SolidColor>
                        </Stroke>
                    </Shape>
                    <Shape x="27" y="0" name="Iris R">
                        <Ellipse width="30" height="31" originX="0.5" originY="0.5" name="Path"/>
                        <Fill name="Fill"><SolidColor colorValue="FFD9902E" name="C"/></Fill>
                        <Stroke thickness="2.5" name="Rim">
                            <SolidColor colorValue="FF5A3A22" name="C">
                                <DataBindContext sourcePathIds="0:500-0:504" propertyKey="37"/>
                            </SolidColor>
                        </Stroke>
                    </Shape>
                </Node>

                <Shape x="0" y="22" rotation="3.1415927" name="Nose">
                    <Triangle width="14" height="10" originX="0.5" originY="0.5" name="Path"/>
                    <Fill name="Fill"><SolidColor colorValue="FFE79A9A" name="C"/></Fill>
                </Shape>
                <Shape x="0" y="0" name="Mouth">
                    <PointsPath isClosed="false" name="Path">
                        <StraightVertex x="-9" y="31" radius="3"/>
                        <StraightVertex x="-4" y="35" radius="3"/>
                        <StraightVertex x="0" y="30" radius="2"/>
                        <StraightVertex x="4" y="35" radius="3"/>
                        <StraightVertex x="9" y="31" radius="3"/>
                    </PointsPath>
                    <Stroke thickness="2.5" cap="round" join="round" name="Stroke">
                        <SolidColor colorValue="FF5A3A22" name="C">
                            <DataBindContext sourcePathIds="0:500-0:504" propertyKey="37"/>
                        </SolidColor>
                    </Stroke>
                </Shape>
                <Shape x="-44" y="24" name="Blush L">
                    <Ellipse width="18" height="9" originX="0.5" originY="0.5" name="Path"/>
                    <Fill name="Fill"><SolidColor colorValue="40E77A7A" name="C"/></Fill>
                </Shape>
                <Shape x="44" y="24" name="Blush R">
                    <Ellipse width="18" height="9" originX="0.5" originY="0.5" name="Path"/>
                    <Fill name="Fill"><SolidColor colorValue="40E77A7A" name="C"/></Fill>
                </Shape>

                <!-- Head, then cheek ruff below it so only the silhouette outline shows -->
                <Shape x="0" y="0" name="Head Shape">
                    <Ellipse width="148" height="118" originX="0.5" originY="0.5" name="Path"/>
                    <Fill name="Fill">
                        <SolidColor colorValue="FFEFE1CC" name="C">
                            <DataBindContext sourcePathIds="0:500-0:501" propertyKey="37"/>
                        </SolidColor>
                    </Fill>
                    <Stroke thickness="3" name="Outline">
                        <SolidColor colorValue="FF7A5C46" name="C">
                            <DataBindContext sourcePathIds="0:500-0:504" propertyKey="37"/>
                        </SolidColor>
                    </Stroke>
                </Shape>
                <Shape x="-44" y="26" name="Cheek L">
                    <Ellipse width="58" height="44" originX="0.5" originY="0.5" name="Path"/>
                    <Fill name="Fill">
                        <SolidColor colorValue="FFEFE1CC" name="C">
                            <DataBindContext sourcePathIds="0:500-0:501" propertyKey="37"/>
                        </SolidColor>
                    </Fill>
                    <Stroke thickness="3" name="Outline">
                        <SolidColor colorValue="FF7A5C46" name="C">
                            <DataBindContext sourcePathIds="0:500-0:504" propertyKey="37"/>
                        </SolidColor>
                    </Stroke>
                </Shape>
                <Shape x="44" y="26" name="Cheek R">
                    <Ellipse width="58" height="44" originX="0.5" originY="0.5" name="Path"/>
                    <Fill name="Fill">
                        <SolidColor colorValue="FFEFE1CC" name="C">
                            <DataBindContext sourcePathIds="0:500-0:501" propertyKey="37"/>
                        </SolidColor>
                    </Fill>
                    <Stroke thickness="3" name="Outline">
                        <SolidColor colorValue="FF7A5C46" name="C">
                            <DataBindContext sourcePathIds="0:500-0:504" propertyKey="37"/>
                        </SolidColor>
                    </Stroke>
                </Shape>

                <!-- Ears: small, set low and wide (Persian); pivot at ear base for twitches -->
                <Node x="-40" y="-40" rotation="-0.45" name="Ear L" id="0:24">
                    <Shape x="0" y="-6" name="Inner">
                        <Triangle width="18" height="18" originX="0.5" originY="0.5" name="Path"/>
                        <Fill name="Fill"><SolidColor colorValue="FFF0B4B0" name="C"/></Fill>
                    </Shape>
                    <Shape x="0" y="-8" name="Outer">
                        <Triangle width="36" height="34" originX="0.5" originY="0.5" name="Path"/>
                        <Fill name="Fill">
                            <SolidColor colorValue="FFEFE1CC" name="C">
                                <DataBindContext sourcePathIds="0:500-0:501" propertyKey="37"/>
                            </SolidColor>
                        </Fill>
                        <Stroke thickness="3" join="round" name="Outline">
                            <SolidColor colorValue="FF7A5C46" name="C">
                                <DataBindContext sourcePathIds="0:500-0:504" propertyKey="37"/>
                            </SolidColor>
                        </Stroke>
                    </Shape>
                </Node>
                <Node x="40" y="-40" rotation="0.45" name="Ear R" id="0:25">
                    <Shape x="0" y="-6" name="Inner">
                        <Triangle width="18" height="18" originX="0.5" originY="0.5" name="Path"/>
                        <Fill name="Fill"><SolidColor colorValue="FFF0B4B0" name="C"/></Fill>
                    </Shape>
                    <Shape x="0" y="-8" name="Outer">
                        <Triangle width="36" height="34" originX="0.5" originY="0.5" name="Path"/>
                        <Fill name="Fill">
                            <SolidColor colorValue="FFEFE1CC" name="C">
                                <DataBindContext sourcePathIds="0:500-0:501" propertyKey="37"/>
                            </SolidColor>
                        </Fill>
                        <Stroke thickness="3" join="round" name="Outline">
                            <SolidColor colorValue="FF7A5C46" name="C">
                                <DataBindContext sourcePathIds="0:500-0:504" propertyKey="37"/>
                            </SolidColor>
                        </Stroke>
                    </Shape>
                </Node>
            </Node>

            <!-- Body group: pivot on the ground so breathing swells upward -->
            <Node x="0" y="0" name="Body" id="0:21">
                <Shape x="-30" y="-10" name="Paw L">
                    <Ellipse width="44" height="26" originX="0.5" originY="0.5" name="Path"/>
                    <Fill name="Fill">
                        <SolidColor colorValue="FFEFE1CC" name="C">
                            <DataBindContext sourcePathIds="0:500-0:501" propertyKey="37"/>
                        </SolidColor>
                    </Fill>
                    <Stroke thickness="3" name="Outline">
                        <SolidColor colorValue="FF7A5C46" name="C">
                            <DataBindContext sourcePathIds="0:500-0:504" propertyKey="37"/>
                        </SolidColor>
                    </Stroke>
                </Shape>
                <Shape x="30" y="-10" name="Paw R">
                    <Ellipse width="44" height="26" originX="0.5" originY="0.5" name="Path"/>
                    <Fill name="Fill">
                        <SolidColor colorValue="FFEFE1CC" name="C">
                            <DataBindContext sourcePathIds="0:500-0:501" propertyKey="37"/>
                        </SolidColor>
                    </Fill>
                    <Stroke thickness="3" name="Outline">
                        <SolidColor colorValue="FF7A5C46" name="C">
                            <DataBindContext sourcePathIds="0:500-0:504" propertyKey="37"/>
                        </SolidColor>
                    </Stroke>
                </Shape>
                <Shape x="0" y="-82" name="Chest Fluff">
                    <Ellipse width="86" height="76" originX="0.5" originY="0.5" name="Path"/>
                    <Fill name="Fill">
                        <SolidColor colorValue="FFFFF8EE" name="C">
                            <DataBindContext sourcePathIds="0:500-0:503" propertyKey="37"/>
                        </SolidColor>
                    </Fill>
                </Shape>
                <Shape x="0" y="-70" name="Body Shape">
                    <Ellipse width="156" height="144" originX="0.5" originY="0.5" name="Path"/>
                    <Fill name="Fill">
                        <SolidColor colorValue="FFEFE1CC" name="C">
                            <DataBindContext sourcePathIds="0:500-0:501" propertyKey="37"/>
                        </SolidColor>
                    </Fill>
                    <Stroke thickness="3" name="Outline">
                        <SolidColor colorValue="FF7A5C46" name="C">
                            <DataBindContext sourcePathIds="0:500-0:504" propertyKey="37"/>
                        </SolidColor>
                    </Stroke>
                </Shape>
            </Node>
        </Node>

        <!-- Tail: a thick stroked path skinned to a 3-bone chain, in artboard space.
             Bound straight along +x (identity bind matrices); authored bone rotations curl it up. -->
        <Shape name="Tail">
            <PointsPath isClosed="false" name="Path">
                <StraightVertex x="238" y="352" radius="20"><Weight values="255" indices="1"/></StraightVertex>
                <StraightVertex x="244" y="352" radius="20"><Weight values="255" indices="1"/></StraightVertex>
                <StraightVertex x="250" y="352" radius="20"><Weight values="255" indices="1"/></StraightVertex>
                <StraightVertex x="256" y="352" radius="20"><Weight values="255" indices="1"/></StraightVertex>
                <StraightVertex x="262" y="352" radius="20"><Weight values="255" indices="1"/></StraightVertex>
                <StraightVertex x="268" y="352" radius="20"><Weight values="8160" indices="513"/></StraightVertex>
                <StraightVertex x="274" y="352" radius="20"><Weight values="18870" indices="513"/></StraightVertex>
                <StraightVertex x="280" y="352" radius="20"><Weight values="29580" indices="513"/></StraightVertex>
                <StraightVertex x="286" y="352" radius="20"><Weight values="40290" indices="513"/></StraightVertex>
                <StraightVertex x="292" y="352" radius="20"><Weight values="51000" indices="513"/></StraightVertex>
                <StraightVertex x="298" y="352" radius="20"><Weight values="61710" indices="513"/></StraightVertex>
                <StraightVertex x="304" y="352" radius="20"><Weight values="7905" indices="770"/></StraightVertex>
                <StraightVertex x="310" y="352" radius="20"><Weight values="19380" indices="770"/></StraightVertex>
                <StraightVertex x="316" y="352" radius="20"><Weight values="30855" indices="770"/></StraightVertex>
                <StraightVertex x="322" y="352" radius="20"><Weight values="42330" indices="770"/></StraightVertex>
                <StraightVertex x="328" y="352" radius="20"><Weight values="53805" indices="770"/></StraightVertex>
                <StraightVertex x="334" y="352" radius="20"><Weight values="255" indices="3"/></StraightVertex>
                <StraightVertex x="340" y="352" radius="20"><Weight values="255" indices="3"/></StraightVertex>
                <StraightVertex x="346" y="352" radius="20"><Weight values="255" indices="3"/></StraightVertex>
                <StraightVertex x="352" y="352" radius="20"><Weight values="255" indices="3"/></StraightVertex>
                <Skin tx="0" ty="0" name="Skin">
                    <Tendon boneId="0:30" tx="245" ty="352" name="T Base"/>
                    <Tendon boneId="0:31" tx="282" ty="352" name="T Mid"/>
                    <Tendon boneId="0:32" tx="318" ty="352" name="T Tip"/>
                </Skin>
            </PointsPath>
            <Stroke thickness="38" cap="round" join="round" name="Outline">
                <SolidColor colorValue="FF7A5C46" name="C">
                    <DataBindContext sourcePathIds="0:500-0:504" propertyKey="37"/>
                </SolidColor>
            </Stroke>
            <Stroke thickness="32" cap="round" join="round" name="Fur">
                <SolidColor colorValue="FFEFE1CC" name="C">
                    <DataBindContext sourcePathIds="0:500-0:501" propertyKey="37"/>
                </SolidColor>
            </Stroke>
        </Shape>

        <RootBone x="245" y="352" length="37" rotation="0" name="Tail Base" id="0:30">
            <Bone length="36" rotation="-0.55" name="Tail Mid" id="0:31">
                <Bone length="32" rotation="-0.75" name="Tail Tip" id="0:32"/>
            </Bone>
        </RootBone>

        <!-- One layer per independent idle behaviour; different loop lengths so they never sync up -->
        <StateMachine name="Idle" id="0:7">
            <StateMachineLayer name="Breathe" id="0:8">
                <AnyState/><ExitState/>
                <EntryState><StateTransition stateToId="0:60"/></EntryState>
                <AnimationState animationId="0:40" id="0:60"/>
            </StateMachineLayer>
            <StateMachineLayer name="Blink" id="0:9">
                <AnyState/><ExitState/>
                <EntryState><StateTransition stateToId="0:61"/></EntryState>
                <AnimationState animationId="0:41" id="0:61"/>
            </StateMachineLayer>
            <StateMachineLayer name="Tail" id="0:10">
                <AnyState/><ExitState/>
                <EntryState><StateTransition stateToId="0:62"/></EntryState>
                <AnimationState animationId="0:42" id="0:62"/>
            </StateMachineLayer>
            <StateMachineLayer name="Ears" id="0:11">
                <AnyState/><ExitState/>
                <EntryState><StateTransition stateToId="0:63"/></EntryState>
                <AnimationState animationId="0:43" id="0:63"/>
            </StateMachineLayer>
        </StateMachine>

        <!-- Breathe: 4 s, body swells 2.5% from the ground, head rides up 2 px -->
        <LinearAnimation loopValue="loop" duration="240" name="Breathe" id="0:40">
            <KeyedObject objectId="0:21">
                <KeyedProperty property="scaleY">
                    <KeyFrameDouble value="1" frame="0" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="1.025" frame="110" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="1" frame="240"/>
                </KeyedProperty>
                <KeyedProperty property="scaleX">
                    <KeyFrameDouble value="1" frame="0" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="1.01" frame="110" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="1" frame="240"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:22">
                <KeyedProperty property="y">
                    <KeyFrameDouble value="-178" frame="0" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="-181" frame="118" interpolationType="cubic"><CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="-178" frame="240"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <!-- Blink: 5.5 s loop, a single blink then a later double blink -->
        <LinearAnimation loopValue="loop" duration="330" name="Blink" id="0:41">
            <KeyedObject objectId="0:23">
                <KeyedProperty property="scaleY">
                    <KeyFrameDouble value="1" frame="0" interpolationType="hold"/>
                    <KeyFrameDouble value="1" frame="120" interpolationType="cubic"><CubicEaseInterpolator x1="0.4" y1="0" x2="1" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="0.08" frame="125" interpolationType="cubic"><CubicEaseInterpolator x1="0" y1="0" x2="0.6" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="1" frame="132" interpolationType="hold"/>
                    <KeyFrameDouble value="1" frame="280" interpolationType="cubic"><CubicEaseInterpolator x1="0.4" y1="0" x2="1" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="0.08" frame="285" interpolationType="cubic"><CubicEaseInterpolator x1="0" y1="0" x2="0.6" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="1" frame="291" interpolationType="cubic"><CubicEaseInterpolator x1="0.4" y1="0" x2="1" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="0.08" frame="296" interpolationType="cubic"><CubicEaseInterpolator x1="0" y1="0" x2="0.6" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="1" frame="303" interpolationType="hold"/>
                    <KeyFrameDouble value="1" frame="330"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <!-- Tail: 7 s lazy sway; each bone lags the one before it (overlapping action) -->
        <LinearAnimation loopValue="loop" duration="420" name="Tail Sway" id="0:42">
            <KeyedObject objectId="0:30">
                <KeyedProperty property="rotation">
                    <KeyFrameDouble value="0.05" frame="0" interpolationType="cubic"><CubicEaseInterpolator x1="0.45" y1="0" x2="0.55" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="-0.12" frame="210" interpolationType="cubic"><CubicEaseInterpolator x1="0.45" y1="0" x2="0.55" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="0.05" frame="420"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:31">
                <KeyedProperty property="rotation">
                    <KeyFrameDouble value="-0.40" frame="0" interpolationType="cubic"><CubicEaseInterpolator x1="0.45" y1="0" x2="0.55" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="-0.40" frame="40" interpolationType="cubic"><CubicEaseInterpolator x1="0.45" y1="0" x2="0.55" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="-0.72" frame="250" interpolationType="cubic"><CubicEaseInterpolator x1="0.45" y1="0" x2="0.55" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="-0.40" frame="420"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:32">
                <KeyedProperty property="rotation">
                    <KeyFrameDouble value="-0.95" frame="0" interpolationType="cubic"><CubicEaseInterpolator x1="0.45" y1="0" x2="0.55" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="-0.95" frame="80" interpolationType="cubic"><CubicEaseInterpolator x1="0.45" y1="0" x2="0.55" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="-0.45" frame="290" interpolationType="cubic"><CubicEaseInterpolator x1="0.45" y1="0" x2="0.55" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="-0.95" frame="420"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <!-- Ears: 9 s loop, one quick left-ear flick -->
        <LinearAnimation loopValue="loop" duration="540" name="Ear Twitch" id="0:43">
            <KeyedObject objectId="0:24">
                <KeyedProperty property="rotation">
                    <KeyFrameDouble value="-0.45" frame="0" interpolationType="hold"/>
                    <KeyFrameDouble value="-0.45" frame="300" interpolationType="cubic"><CubicEaseInterpolator x1="0.3" y1="0" x2="0.7" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="-0.75" frame="305" interpolationType="cubic"><CubicEaseInterpolator x1="0.3" y1="0" x2="0.7" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="-0.38" frame="312" interpolationType="cubic"><CubicEaseInterpolator x1="0.3" y1="0" x2="0.7" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="-0.45" frame="320" interpolationType="hold"/>
                    <KeyFrameDouble value="-0.45" frame="540"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>
    </Artboard>

    <!-- Colours the app sets at runtime. coatShade/highlight/outline are derived from coatBase by the app. -->
    <ViewModel defaultInstanceId="0:510" name="PetLook" id="0:500">
        <ViewModelPropertyColor name="coatBase" id="0:501"/>
        <ViewModelPropertyColor name="coatShade" id="0:502"/>
        <ViewModelPropertyColor name="coatHighlight" id="0:503"/>
        <ViewModelPropertyColor name="outline" id="0:504"/>
        <ViewModelInstance exports="true" name="Cream" id="0:510">
            <ViewModelInstanceColor propertyValue="FFEFE1CC" viewModelPropertyId="0:501"/>
            <ViewModelInstanceColor propertyValue="FFD9C4A6" viewModelPropertyId="0:502"/>
            <ViewModelInstanceColor propertyValue="FFFFF8EE" viewModelPropertyId="0:503"/>
            <ViewModelInstanceColor propertyValue="FF7A5C46" viewModelPropertyId="0:504"/>
        </ViewModelInstance>
    </ViewModel>
</Rive>
